#
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  ⚠️ 실제 .env 는 커밋하지 마세요.
# 키는 오직 이 백엔드에서만 사용되며, 브라우저/리포지토리에는 절대 두지 않습니다.

# Anthropic API 키 (서버 전용). 콘솔에서 발급받은 실제 키로 교체하세요.
ANTHROPIC_API_KEY=sk-ant-...replace-with-your-real-key...

# 사용할 모델 (기본: claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5

# 프록시 포트 (기본: 8790)
PORT=8790

# CORS 허용 오리진 (기본: * / 운영에서는 프런트 도메인으로 제한 권장)
CORS_ORIGIN=*

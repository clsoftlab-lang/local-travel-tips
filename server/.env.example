#
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  ⚠️ 실제 .env 는 커밋하지 마세요.
# 키는 오직 이 백엔드에서만 사용되며, 브라우저/리포지토리에는 절대 두지 않습니다.

# Anthropic API 키 (서버 전용). 콘솔에서 발급받은 실제 키로 교체하세요.
ANTHROPIC_API_KEY=sk-ant-...replace-with-your-real-key...

# 사용할 모델 (비용 우선 기본: claude-haiku-4-5)
# 품질을 높이려면 claude-sonnet-5 또는 claude-opus-5 로 올리세요.
AI_MODEL=claude-haiku-4-5
# (구버전 호환용 폴백; AI_MODEL 이 우선합니다)
# ANTHROPIC_MODEL=claude-haiku-4-5

# 효율(effort). haiku 는 무시하며, sonnet/opus 일 때만 적용됩니다. (기본: low)
AI_EFFORT=low

# 비용 가드레일: 월간 토큰 예산 (기본: 2000000). 초과 시 429 {fallback:true}
AI_MONTHLY_TOKEN_CAP=2000000

# 비용 가드레일: IP 당 분당 요청 수 (기본: 20)
AI_RATE_PER_MIN=20

# 프록시 포트 (기본: 8790)
PORT=8790

# CORS 허용 오리진 (기본: * / 운영에서는 프런트 도메인으로 제한 권장)
CORS_ORIGIN=*
